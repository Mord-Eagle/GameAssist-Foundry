# Keep repository text stable across Windows development and Unix-based CI.
* text=auto eol=lf

# Windows command scripts require native command-shell line endings.
*.bat text eol=crlf
*.cmd text eol=crlf

# Common binary assets must never receive text normalization.
*.avif binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.mp3 binary
*.ogg binary
*.otf binary
*.png binary
*.ttf binary
*.wav binary
*.webm binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary
